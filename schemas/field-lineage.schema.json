{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/splunk-content-hygiene/field-lineage.schema.json",
  "title": "Content Hygiene Declared Field Metadata",
  "$defs": {
    "names": { "type": "array", "maxItems": 250, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "scope": { "anyOf": [{ "type": "null" }, {
      "type": "object", "required": ["field", "value", "exact"], "additionalProperties": false,
      "properties": { "field": { "enum": ["sourcetype", "host", "source"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 4096 }, "exact": { "type": "boolean" } }
    }] },
    "phase": { "enum": ["extraction", "alias", "calculated", "lookup"] },
    "propsContexts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/propsContext" } },
    "propsContext": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "objectId", "app", "status", "selectedObjectId", "valueDigest", "reason"],
      "properties": {
        "version": { "const": 1 }, "objectId": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "app": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status": { "enum": ["local", "inherited", "shadowed", "unverified"] },
        "selectedObjectId": { "type": ["string", "null"], "minLength": 1, "maxLength": 16384 },
        "valueDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "reason": { "enum": ["matched", "different_binding", "not_returned", "access_denied", "snapshot_changed", "metadata_mismatch", "unsupported_scope", "budget", "request_failed"] },
        "stanzaPriority": { "type": ["number", "null"], "minimum": -1000000000, "maximum": 1000000000 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "unverified" } } },
          "then": { "properties": { "selectedObjectId": { "type": "null" }, "valueDigest": { "type": "null" }, "stanzaPriority": { "type": "null" }, "reason": { "not": { "enum": ["matched", "different_binding"] } } } },
          "else": { "properties": { "selectedObjectId": { "type": "string" }, "valueDigest": { "type": "string" } } } },
        { "if": { "properties": { "status": { "enum": ["local", "inherited"] } } }, "then": { "properties": { "reason": { "const": "matched" } } } },
        { "if": { "properties": { "status": { "const": "shadowed" } } }, "then": { "properties": { "reason": { "const": "different_binding" } } } }
      ]
    },
    "crossStanzaProps": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/crossStanzaProp" } },
    "crossStanzaProp": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "objectId", "callerObjectId", "app", "attribute", "sourceLocation", "selectors", "status", "reason", "selectedObjectId", "competingObjectIds", "stanzaPriority", "selectedPriority"],
      "properties": {
        "version": { "const": 1 }, "objectId": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "callerObjectId": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "app": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "attribute": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceLocation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "selectors": { "type": "array", "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "value", "sourceLocation"],
          "properties": { "field": { "enum": ["sourcetype", "host", "source"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "sourceLocation": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        } },
        "status": { "enum": ["highest", "lower", "unverified"] },
        "reason": { "enum": ["category", "priority", "ascii", "single_stanza", "no_conjunction", "binding_unverified", "case_ambiguous", "budget", "incomplete_catalog", "same_stanza_shadow"] },
        "selectedObjectId": { "type": ["string", "null"], "minLength": 1, "maxLength": 16384 },
        "stanzaPriority": { "type": ["number", "null"], "minimum": -1000000000, "maximum": 1000000000 },
        "selectedPriority": { "type": ["number", "null"], "minimum": -1000000000, "maximum": 1000000000 },
        "competingObjectIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "unverified" } } },
        "then": { "properties": { "selectedObjectId": { "type": "null" }, "selectedPriority": { "type": "null" }, "reason": { "not": { "enum": ["category", "priority", "ascii"] } } } },
        "else": { "properties": { "selectedObjectId": { "type": "string" }, "selectors": { "minItems": 1 }, "competingObjectIds": { "minItems": 2 }, "reason": { "enum": ["category", "priority", "ascii"] } } } }]
    },
    "lookupMapping": {
      "type": "object", "additionalProperties": false, "required": ["version", "inputs", "outputs", "outputMode"],
      "properties": { "version": { "const": 1 }, "outputMode": { "enum": ["OUTPUT", "OUTPUTNEW", "implicit"] },
        "inputs": { "type": "array", "minItems": 1, "maxItems": 250, "items": { "$ref": "#/$defs/lookupField" } },
        "outputs": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/lookupField" } } }
    },
    "lookupField": {
      "type": "object", "additionalProperties": false, "required": ["lookupField", "eventField", "position"],
      "properties": { "lookupField": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "eventField": { "type": "string", "minLength": 1, "maxLength": 4096 }, "position": { "type": "integer", "minimum": 1, "maximum": 250 } }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["declaringApp", "dependencyApp", "invokingApp", "declaration", "dependency", "selector"],
      "properties": { "declaringApp": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "dependencyApp": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
        "invokingApp": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "declaration": { "enum": ["local_candidate", "exported_candidate"] }, "dependency": { "enum": ["local_candidate", "exported_candidate", "unresolved"] },
        "selector": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["field", "value", "sourceLocation"],
          "properties": { "field": { "enum": ["sourcetype", "host", "source"] }, "value": { "type": "string", "minLength": 1, "maxLength": 4096 }, "sourceLocation": { "type": "string", "minLength": 1, "maxLength": 4096 } } }] } }
    },
    "outputMethod": { "enum": ["inline_named_captures", "transform_named_captures", "transform_format", "transform_fields"] },
    "outputDeclaration": {
      "type": "object", "additionalProperties": false, "required": ["field", "capture", "offset", "attribute"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "capture": { "type": ["integer", "null"], "minimum": 1, "maximum": 250 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "attribute": { "enum": ["value", "REGEX", "FORMAT", "FIELDS"] }
      }
    },
    "outputProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "method", "sourceField", "sourceOrigin", "regexCaptureCount", "declarations"],
      "properties": {
        "version": { "const": 1 }, "method": { "$ref": "#/$defs/outputMethod" },
        "sourceField": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
        "sourceOrigin": { "enum": ["default_raw", "explicit_inline", "source_key", "unknown"] },
        "regexCaptureCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 250 },
        "declarations": { "type": "array", "minItems": 1, "maxItems": 250, "items": { "$ref": "#/$defs/outputDeclaration" } }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "inline_named_captures" } } }, "then": { "properties": { "sourceOrigin": { "enum": ["default_raw", "explicit_inline"] }, "regexCaptureCount": { "type": "integer" }, "declarations": { "items": { "properties": { "attribute": { "const": "value" }, "capture": { "type": "integer" } } } } } }, "else": { "properties": { "sourceOrigin": { "enum": ["default_raw", "source_key", "unknown"] } } } },
        { "if": { "properties": { "method": { "const": "transform_named_captures" } } }, "then": { "properties": { "regexCaptureCount": { "type": "integer" }, "declarations": { "items": { "properties": { "attribute": { "const": "REGEX" }, "capture": { "type": "integer" } } } } } } },
        { "if": { "properties": { "method": { "const": "transform_format" } } }, "then": { "properties": { "regexCaptureCount": { "type": "integer" }, "declarations": { "items": { "properties": { "attribute": { "const": "FORMAT" }, "capture": { "type": "integer" } } } } } } },
        { "if": { "properties": { "method": { "const": "transform_fields" } } }, "then": { "properties": { "regexCaptureCount": { "type": "null" }, "declarations": { "items": { "properties": { "attribute": { "const": "FIELDS" }, "capture": { "type": "null" } } } } } } },
        { "if": { "properties": { "sourceOrigin": { "const": "default_raw" } } }, "then": { "properties": { "sourceField": { "const": "_raw" } } } },
        { "if": { "properties": { "sourceOrigin": { "const": "unknown" } } }, "then": { "properties": { "sourceField": { "type": "null" } } }, "else": { "properties": { "sourceField": { "type": "string" } } } }
      ]
    },
    "producerDeclaration": {
      "type": "object", "additionalProperties": false, "required": ["field", "capture", "offset", "attribute", "objectId", "method"],
      "properties": {
        "field": { "$ref": "#/$defs/outputDeclaration/properties/field" }, "capture": { "$ref": "#/$defs/outputDeclaration/properties/capture" },
        "offset": { "$ref": "#/$defs/outputDeclaration/properties/offset" }, "attribute": { "$ref": "#/$defs/outputDeclaration/properties/attribute" },
        "objectId": { "type": "string", "minLength": 1, "maxLength": 16384 }, "method": { "$ref": "#/$defs/outputMethod" }
      }
    },
    "facts": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "operation", "stanza", "attribute", "scope", "enabled", "inputs", "outputs", "aliases", "transforms", "syntax", "sourceLocation", "limitations"],
      "properties": {
        "version": { "const": 1 },
        "operation": { "enum": ["inline", "report", "alias", "eval", "transform", "lookup"] },
        "stanza": { "type": ["string", "null"] }, "attribute": { "type": ["string", "null"] },
        "scope": { "$ref": "#/$defs/scope" }, "enabled": { "type": ["boolean", "null"] },
        "inputs": { "$ref": "#/$defs/names" }, "outputs": { "$ref": "#/$defs/names" }, "transforms": { "$ref": "#/$defs/names" },
        "aliases": { "type": "array", "maxItems": 250, "items": {
          "type": "object", "additionalProperties": false, "required": ["input", "output", "mode"],
          "properties": { "input": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "output": { "type": "string", "minLength": 1, "maxLength": 4096 }, "mode": { "enum": ["AS", "ASNEW"] } }
        } },
        "syntax": { "enum": ["declared", "partial", "unsupported"] }, "sourceLocation": { "type": "string" },
        "limitations": { "type": "array", "maxItems": 250, "items": { "type": "string" } },
        "outputProvenance": { "$ref": "#/$defs/outputProvenance" },
        "lookupMapping": { "$ref": "#/$defs/lookupMapping" },
        "propsContexts": { "$ref": "#/$defs/propsContexts" }, "propsContextsTruncated": { "type": "boolean" },
        "crossStanzaProps": { "$ref": "#/$defs/crossStanzaProps" }, "crossStanzaPropsTruncated": { "type": "boolean" }
      }
    },
    "callerWitness": {
      "type": "object", "additionalProperties": false, "required": ["callerObjectId", "app", "sourceLocation", "selectors"],
      "properties": {
        "callerObjectId": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "app": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceLocation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "selectors": { "type": "array", "minItems": 2, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "value", "sourceLocation"],
          "properties": { "field": { "enum": ["sourcetype", "host", "source"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "sourceLocation": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        } }
      }
    },
    "scopeCompatibility": {
      "type": "object", "additionalProperties": false, "required": ["version", "consumer", "producer", "basis"],
      "properties": { "version": { "const": 1 }, "consumer": { "$ref": "#/$defs/scope", "type": "object" },
        "producer": { "$ref": "#/$defs/scope", "type": "object" },
        "basis": { "enum": ["same_literal", "bounded_intersection", "captured_default", "captured_conjunction"] },
        "callerWitnesses": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/callerWitness" } } },
      "allOf": [{ "if": { "properties": { "basis": { "const": "captured_conjunction" } } },
        "then": { "required": ["callerWitnesses"] }, "else": { "not": { "required": ["callerWitnesses"] } } }]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "kind", "fields", "scope", "consumerPhase", "producerPhase", "transformPositions", "viaObjectIds", "contextApps", "invocation"],
      "properties": {
        "version": { "const": 1 }, "kind": { "enum": ["report_binding", "lookup_binding", "field_input", "event_scope"] },
        "fields": { "$ref": "#/$defs/names" }, "scope": { "$ref": "#/$defs/scope" },
        "consumerPhase": { "anyOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }] }, "producerPhase": { "$ref": "#/$defs/phase" },
        "transformPositions": { "type": "array", "maxItems": 250, "items": { "type": "integer", "minimum": 1, "maximum": 250 } },
        "viaObjectIds": { "type": "array", "maxItems": 250, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } }, "contextApps": { "$ref": "#/$defs/names" },
        "invocation": { "enum": ["fixed_app", "invoking_app_unverified"] },
        "outputDeclarations": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/producerDeclaration" } },
        "scopeCompatibility": { "$ref": "#/$defs/scopeCompatibility" },
        "contexts": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/context" } },
        "propsContexts": { "$ref": "#/$defs/propsContexts" }, "propsContextsTruncated": { "type": "boolean" },
        "crossStanzaProps": { "$ref": "#/$defs/crossStanzaProps" }, "crossStanzaPropsTruncated": { "type": "boolean" }
      }
    }
  }
}
