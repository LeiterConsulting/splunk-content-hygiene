{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/splunk-content-hygiene/field-lineage.schema.json",
  "title": "Content Hygiene Declared Field Metadata",
  "$defs": {
    "names": { "type": "array", "maxItems": 250, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "scope": { "anyOf": [{ "type": "null" }, {
      "type": "object", "required": ["field", "value", "exact"], "additionalProperties": false,
      "properties": { "field": { "enum": ["sourcetype", "host", "source"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 4096 }, "exact": { "type": "boolean" } }
    }] },
    "phase": { "enum": ["extraction", "alias", "calculated", "lookup"] },
    "outputMethod": { "enum": ["inline_named_captures", "transform_named_captures", "transform_format", "transform_fields"] },
    "outputDeclaration": {
      "type": "object", "additionalProperties": false, "required": ["field", "capture", "offset", "attribute"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "capture": { "type": ["integer", "null"], "minimum": 1, "maximum": 250 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "attribute": { "enum": ["value", "REGEX", "FORMAT", "FIELDS"] }
      }
    },
    "outputProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "method", "sourceField", "sourceOrigin", "regexCaptureCount", "declarations"],
      "properties": {
        "version": { "const": 1 }, "method": { "$ref": "#/$defs/outputMethod" },
        "sourceField": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
        "sourceOrigin": { "enum": ["default_raw", "explicit_inline", "source_key", "unknown"] },
        "regexCaptureCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 250 },
        "declarations": { "type": "array", "minItems": 1, "maxItems": 250, "items": { "$ref": "#/$defs/outputDeclaration" } }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "inline_named_captures" } } }, "then": { "properties": { "sourceOrigin": { "enum": ["default_raw", "explicit_inline"] }, "regexCaptureCount": { "type": "integer" }, "declarations": { "items": { "properties": { "attribute": { "const": "value" }, "capture": { "type": "integer" } } } } } }, "else": { "properties": { "sourceOrigin": { "enum": ["default_raw", "source_key", "unknown"] } } } },
        { "if": { "properties": { "method": { "const": "transform_named_captures" } } }, "then": { "properties": { "regexCaptureCount": { "type": "integer" }, "declarations": { "items": { "properties": { "attribute": { "const": "REGEX" }, "capture": { "type": "integer" } } } } } } },
        { "if": { "properties": { "method": { "const": "transform_format" } } }, "then": { "properties": { "regexCaptureCount": { "type": "integer" }, "declarations": { "items": { "properties": { "attribute": { "const": "FORMAT" }, "capture": { "type": "integer" } } } } } } },
        { "if": { "properties": { "method": { "const": "transform_fields" } } }, "then": { "properties": { "regexCaptureCount": { "type": "null" }, "declarations": { "items": { "properties": { "attribute": { "const": "FIELDS" }, "capture": { "type": "null" } } } } } } },
        { "if": { "properties": { "sourceOrigin": { "const": "default_raw" } } }, "then": { "properties": { "sourceField": { "const": "_raw" } } } },
        { "if": { "properties": { "sourceOrigin": { "const": "unknown" } } }, "then": { "properties": { "sourceField": { "type": "null" } } }, "else": { "properties": { "sourceField": { "type": "string" } } } }
      ]
    },
    "producerDeclaration": {
      "type": "object", "additionalProperties": false, "required": ["field", "capture", "offset", "attribute", "objectId", "method"],
      "properties": {
        "field": { "$ref": "#/$defs/outputDeclaration/properties/field" }, "capture": { "$ref": "#/$defs/outputDeclaration/properties/capture" },
        "offset": { "$ref": "#/$defs/outputDeclaration/properties/offset" }, "attribute": { "$ref": "#/$defs/outputDeclaration/properties/attribute" },
        "objectId": { "type": "string", "minLength": 1, "maxLength": 16384 }, "method": { "$ref": "#/$defs/outputMethod" }
      }
    },
    "facts": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "operation", "stanza", "attribute", "scope", "enabled", "inputs", "outputs", "aliases", "transforms", "syntax", "sourceLocation", "limitations"],
      "properties": {
        "version": { "const": 1 },
        "operation": { "enum": ["inline", "report", "alias", "eval", "transform", "lookup"] },
        "stanza": { "type": ["string", "null"] }, "attribute": { "type": ["string", "null"] },
        "scope": { "$ref": "#/$defs/scope" }, "enabled": { "type": ["boolean", "null"] },
        "inputs": { "$ref": "#/$defs/names" }, "outputs": { "$ref": "#/$defs/names" }, "transforms": { "$ref": "#/$defs/names" },
        "aliases": { "type": "array", "maxItems": 250, "items": {
          "type": "object", "additionalProperties": false, "required": ["input", "output", "mode"],
          "properties": { "input": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "output": { "type": "string", "minLength": 1, "maxLength": 4096 }, "mode": { "enum": ["AS", "ASNEW"] } }
        } },
        "syntax": { "enum": ["declared", "partial", "unsupported"] }, "sourceLocation": { "type": "string" },
        "limitations": { "type": "array", "maxItems": 250, "items": { "type": "string" } },
        "outputProvenance": { "$ref": "#/$defs/outputProvenance" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "kind", "fields", "scope", "consumerPhase", "producerPhase", "transformPositions", "viaObjectIds", "contextApps", "invocation"],
      "properties": {
        "version": { "const": 1 }, "kind": { "enum": ["report_binding", "field_input", "event_scope"] },
        "fields": { "$ref": "#/$defs/names" }, "scope": { "$ref": "#/$defs/scope" },
        "consumerPhase": { "anyOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }] }, "producerPhase": { "$ref": "#/$defs/phase" },
        "transformPositions": { "type": "array", "maxItems": 250, "items": { "type": "integer", "minimum": 1, "maximum": 250 } },
        "viaObjectIds": { "type": "array", "maxItems": 250, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } }, "contextApps": { "$ref": "#/$defs/names" },
        "invocation": { "enum": ["fixed_app", "invoking_app_unverified"] },
        "outputDeclarations": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/producerDeclaration" } }
      }
    }
  }
}
