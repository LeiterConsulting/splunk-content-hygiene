{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/splunk-content-hygiene/settings.schema.json",
  "title": "Content Hygiene Settings",
  "type": "object",
  "properties": {
    "inventory_cron": {
      "type": "string"
    },
    "usage_cron": {
      "type": "string"
    },
    "full_rescan_cron": {
      "type": "string"
    },
    "default_dormant_days": {
      "type": "integer",
      "minimum": 1
    },
    "protected_apps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_scan_runtime_seconds": {
      "type": "integer",
      "minimum": 60
    },
    "max_graph_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "additionalProperties": false
}
