{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/splunk-content-hygiene/scan-run.schema.json",
  "title": "Content Hygiene Scan Run",
  "type": "object",
  "required": ["scan_id", "scan_type", "status", "started_at"],
  "properties": {
    "snapshot_version": { "type": "integer", "const": 2 },
    "evidence_retired": { "type": "boolean" },
    "scan_id": {
      "type": "string"
    },
    "scan_type": {
      "enum": ["bounded", "full", "incremental", "usage", "ownership", "rescore"]
    },
    "status": {
      "enum": ["queued", "running", "partial", "succeeded", "failed", "cancelled"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collector_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "collector_counts": {
      "description": "Normalized shared records produced by each collector.",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "collector_totals": {
      "description": "Visible native-entry totals, not expanded assignment counts.",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "collector_native_counts": {
      "description": "Native entries actually collected. Optional for older snapshots.",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "inventory_scan_id": {
      "type": "string"
    },
    "usage_window_days": {
      "enum": [30, 90, 180]
    },
    "usage_window_start": {
      "type": "string",
      "format": "date-time"
    },
    "usage_window_end": {
      "type": "string",
      "format": "date-time"
    },
    "usage_coverage": {
      "enum": ["complete", "partial", "unavailable"]
    }
  },
  "additionalProperties": true
}
