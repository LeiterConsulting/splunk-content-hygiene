{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/splunk-content-hygiene/edge.schema.json",
  "title": "Content Hygiene Dependency Edge",
  "type": "object",
  "required": [
    "edge_id",
    "source_id",
    "target_id",
    "relation",
    "confidence",
    "evidence"
  ],
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "relation": {
      "enum": [
        "references",
        "navigates_to",
        "links_to_report",
        "uses_search_view",
        "opens_view",
        "opens_app",
        "runs_in_app",
        "uses",
        "uses_file",
        "uses_lookup",
        "may_use_lookup",
        "may_apply_automatic_lookup",
        "matches_event_type",
        "excludes_event_type",
        "matches_tag",
        "excludes_tag",
        "tags_event_type",
        "may_match_event_type",
        "may_exclude_event_type",
        "may_match_tag",
        "may_exclude_tag",
        "may_tag_event_type",
        "may_use_field_transform",
        "may_read_extracted_field",
        "may_read_aliased_field",
        "may_read_calculated_field",
        "may_apply_field_extraction",
        "may_apply_field_alias",
        "may_apply_calculated_field",
        "reads",
        "writes",
        "invokes",
        "searches",
        "filters",
        "feeds",
        "belongs_to",
        "owned_by",
        "unknown"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "source_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved": {
      "type": "boolean"
    },
    "field_provenance": { "$ref": "field-lineage.schema.json#/$defs/provenance" },
    "scan_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
