{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["es2020", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["@testing-library/jest-dom", "@testing-library/react", "jest", "webpack-env", "node"],
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./types"
  },
  "include": ["unit-test-setup-testing-library.ts", "src"]
}
