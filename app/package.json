{
  "name": "splunk-content-hygiene",
  "version": "1.3.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "branding": "node scripts/branding.mjs",
    "branding:verify": "node scripts/branding.mjs --check",
    "build": "yarn workspaces run build",
    "format": "git ls-files | grep -E \"\\.(jsx?|css)$\" | xargs prettier --write",
    "format:verify": "git ls-files | grep -E \"\\.(jsx?|css)$\" | xargs prettier --list-different",
    "lint": "yarn workspaces run lint",
    "package": "yarn build && node scripts/package.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "release:prepare": "yarn validate && node scripts/checksum.mjs",
    "setup": "yarn && yarn build",
    "test:server": "python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:package": "node --test scripts/archive-policy.test.mjs",
    "test": "yarn workspace @splunk/overview run test && yarn workspace @splunk/content-hygiene run test && yarn test:server && yarn test:package",
    "validate": "yarn branding:verify && yarn test && yarn lint && yarn package && yarn package:verify",
    "start": "yarn workspace @splunk/content-hygiene run start"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "prettier": "^3.6.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "resolutions": {
    "moment": "^2.31.0"
  }
}
